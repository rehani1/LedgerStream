# LedgerStream local development placeholders.
# Copy to .env when local services are implemented. Do not commit real secrets.

COMPOSE_PROJECT_NAME=ledgerstream

POSTGRES_DB=ledgerstream
POSTGRES_USER=ledgerstream
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432

REDIS_PORT=6379
BACKEND_REDIS_LATEST_QUOTE_PREFIX=latest_quote

REDPANDA_BROKER=redpanda:9092
REDPANDA_EXTERNAL_PORT=19092

BACKEND_PORT=8080
BACKEND_PROFILE=local
BACKEND_CORS_ALLOWED_ORIGINS=http://localhost:5173
BACKEND_JWT_ISSUER=ledgerstream-local
BACKEND_JWT_SECRET=replace-with-local-development-secret
BACKEND_JWT_ACCESS_TOKEN_TTL=15m
BACKEND_JWT_REFRESH_TOKEN_TTL=7d
BACKEND_KAFKA_CONSUMER_GROUP=ledgerstream-backend
BACKEND_KAFKA_CONNECTIVITY_CONSUMER_ENABLED=false
BACKEND_MARKET_TICK_CONSUMER_ENABLED=true
BACKEND_ORDER_CREATED_CONSUMER_ENABLED=true
BACKEND_KAFKA_SECURITY_PROTOCOL=
BACKEND_KAFKA_SASL_MECHANISM=
BACKEND_KAFKA_SASL_USERNAME=
BACKEND_KAFKA_SASL_PASSWORD=
BACKEND_KAFKA_SASL_JAAS_CONFIG=
BACKEND_LOG_FORMAT=logstash

FRONTEND_PORT=5173
FRONTEND_API_BASE_URL=http://localhost:8080

REDIS_HOST=localhost
MARKET_DATA_KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
MARKET_DATA_KAFKA_SECURITY_PROTOCOL=
MARKET_DATA_KAFKA_SASL_MECHANISM=
MARKET_DATA_KAFKA_SASL_USERNAME=
MARKET_DATA_KAFKA_SASL_PASSWORD=
MARKET_DATA_REPLAY_ENABLED=false
MARKET_DATA_REPLAY_SPEED=1.0
MARKET_DATA_TICK_TOPIC=market.tick
MARKET_DATA_FILE=data/sample_ticks.csv
MARKET_DATA_LOG_LEVEL=INFO
MARKET_DATA_DRY_RUN=false
MARKET_DATA_PRODUCER_FLUSH_TIMEOUT_SECONDS=10

DEMO_SEED_ENABLED=false
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=replace-with-local-demo-password
DEMO_USER_INITIAL_CASH=100000.00
DEMO_ADMIN_SEED_ENABLED=false
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=replace-with-local-demo-admin-password

# Hosted deployment placeholders. Set real values in the platform secret manager, not in Git.
PRODUCTION_FRONTEND_URL=https://ledgerstream.example.app
PRODUCTION_BACKEND_URL=https://ledgerstream-api.example.com
SPRING_PROFILES_ACTIVE=production
SPRING_DATASOURCE_URL=jdbc:postgresql://replace-with-neon-host/ledgerstream?sslmode=require
SPRING_DATASOURCE_USERNAME=replace-with-neon-user
SPRING_DATASOURCE_PASSWORD=replace-with-neon-password
SPRING_DATA_REDIS_URL=rediss://:replace-with-upstash-token@replace-with-upstash-host:6379
